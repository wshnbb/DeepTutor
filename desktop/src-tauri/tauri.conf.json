{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepTutor Desktop",
  "version": "0.1.2",
  "identifier": "io.github.wshnbb.deeptutor",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main", "create": false, "title": "DeepTutor 桌面设置", "width": 1060,
      "height": 760, "minWidth": 800, "minHeight": 640
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": { "runtime/": "runtime/" },
    "shortDescription": "DeepTutor Windows desktop client",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser", "compression": "zlib", "displayLanguageSelector": true, "languages": ["SimpChinese", "English"], "installerHooks": "installer-hooks.nsh" }
    }
  }
}
